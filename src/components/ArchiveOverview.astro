---
import "../styles/archive-overview.css";
import "../styles/reference-query-terminal.css";

export type ArchiveOverviewItem = {
  category?: string;
  covers?: string[];
  date?: Date | string;
  entryKind?: "topic" | "source" | "default";
  eyebrow: string;
  href: string;
  meta?: string;
  summary?: string;
  tags?: Array<string | { key: string; label: string }>;
  title: string;
};

type Props = {
  archiveStyle?: "default" | "blog" | "reference";
  description: string;
  eyebrow: string;
  items: ArchiveOverviewItem[];
  searchPlaceholder: string;
  tagVisibleMinimumEntryCount?: number;
  title: string;
  totalLabel: string;
};

const {
  archiveStyle = "default",
  description,
  eyebrow,
  items,
  searchPlaceholder,
  tagVisibleMinimumEntryCount = 1,
  title,
  totalLabel,
} = Astro.props;
const showViewSwitch = archiveStyle !== "reference";
const referenceTopicCount = items.filter((item) => item.entryKind === "topic").length;

const formatDate = (value: Date | string | undefined) => {
  if (!value) {
    return "持续整理";
  }

  return new Intl.DateTimeFormat("zh-CN", {
    month: "2-digit",
    day: "2-digit",
    year: "numeric",
  }).format(new Date(value));
};

const tagKey = (tag: string | { key: string; label: string }) => typeof tag === "string" ? tag : tag.key;
const tagLabel = (tag: string | { key: string; label: string }) => typeof tag === "string" ? tag : tag.label;
const tagCounts = new Map<string, { count: number; label: string }>();

for (const item of items) {
  for (const tag of item.tags ?? []) {
    const key = tagKey(tag);
    const current = tagCounts.get(key);
    tagCounts.set(key, { count: (current?.count ?? 0) + 1, label: tagLabel(tag) });
  }
}

const sortedTags = [...tagCounts.entries()]
  .sort((left, right) => right[1].count - left[1].count || left[1].label.localeCompare(right[1].label, "zh-CN"));
const topTags = archiveStyle === "reference"
  ? sortedTags.filter(([, { count }]) => count >= tagVisibleMinimumEntryCount)
  : sortedTags.slice(0, 12);
const categoryCounts = new Map<string, number>();
const tagCategories = new Map<string, Set<string>>();

for (const item of items) {
  if (item.category) {
    categoryCounts.set(item.category, (categoryCounts.get(item.category) ?? 0) + 1);
  }

  for (const tag of item.tags ?? []) {
    const key = tagKey(tag);
    if (!tagCategories.has(key)) {
      tagCategories.set(key, new Set());
    }
    if (item.category) {
      tagCategories.get(key)?.add(item.category);
    }
  }
}

const topCategories = [...categoryCounts.entries()].sort(
  (left, right) => right[1] - left[1] || left[0].localeCompare(right[0], "zh-CN"),
);
const referenceTagGroups = topCategories
  .map(([category]) => ({
    category,
    tags: topTags.filter(([tag]) => tagCategories.get(tag)?.has(category)),
  }))
  .filter(({ tags }) => tags.length > 0);
---

{archiveStyle === "reference" ? (
  <section
    class="archive-overview reference-query-terminal"
    data-archive-overview
    data-archive-style="reference"
    data-archive-view="timeline"
    data-reference-query-terminal
  >
    <header class="reference-query-terminal__identity">
      <div class="reference-query-terminal__identity-copy">
        <p class="reference-query-terminal__kicker">REFERENCE ARCHIVE / QUERY TERMINAL</p>
        <h1>{title}</h1>
        <p>{description}</p>
      </div>
      <div class="reference-query-terminal__status" aria-label="资料库状态">
        <span><small>RECORDS</small><strong>{String(items.length).padStart(2, "0")}</strong></span>
        <span><small>TOPICS</small><strong>{String(referenceTopicCount).padStart(2, "0")}</strong></span>
        <span class="is-online"><small>STATE</small><strong>ONLINE</strong></span>
        <span><small>MODE</small><strong>QUERY</strong></span>
      </div>
    </header>

    <section
      class="reference-query-terminal__query"
      aria-label="资料检索"
      data-reference-query-deck
      data-reference-tag-details
    >
      <div class="reference-query-terminal__query-row" data-reference-query-row>
        <label class="reference-query-terminal__search">
          <span>ARCHIVE QUERY</span>
          <span class="reference-query-terminal__search-slot">
            <span aria-hidden="true">⌕</span>
            <input data-archive-search placeholder={searchPlaceholder} type="search" />
            <button data-reference-clear hidden title="清除检索" aria-label="清除检索" type="button">×</button>
          </span>
        </label>
        <div class="reference-query-terminal__query-state">
          <p class="reference-query-terminal__visible-count">
            VISIBLE <output aria-live="polite" data-reference-visible-count>{String(items.length).padStart(2, "0")}</output>
            / {String(items.length).padStart(2, "0")}
          </p>
          <p class="reference-query-terminal__active-summary" data-reference-active-filter-summary hidden>
            <span data-reference-active-primary>全部</span>
            <i aria-hidden="true">/</i>
            <span data-reference-active-tag>全部标签</span>
            <button data-reference-clear-tag hidden aria-label="清除二级标签" title="清除二级标签" type="button">×</button>
          </p>
          <button
            class="reference-query-terminal__tag-toggle"
            type="button"
            aria-controls="reference-secondary-tags"
            aria-expanded="false"
            data-reference-tag-toggle
          >
            <span>标签索引 {topTags.length}</span>
            <span class="reference-query-terminal__tag-symbol" data-reference-tag-symbol aria-hidden="true">+</span>
          </button>
        </div>
      </div>

      <div class="reference-query-terminal__primary-row" data-reference-primary-row>
        <span class="reference-query-terminal__filter-label">SECTION</span>
        <button
          aria-pressed="true"
          class="archive-overview__category is-active"
          data-archive-category="all"
          data-archive-category-label="全部"
          type="button"
        >
          全部 <span>{items.length}</span>
        </button>
        {topCategories.map(([category, count]) => (
          <button
            aria-pressed="false"
            class="archive-overview__category"
            data-archive-category={category}
            data-archive-category-label={category}
            type="button"
          >
            {category} <span>{count}</span>
          </button>
        ))}
      </div>

      <div
        class="reference-query-terminal__secondary-panel reference-query-terminal__tag-drawer"
        id="reference-secondary-tags"
        aria-label="标签筛选"
        data-reference-secondary-panel
        hidden
      >
        <header class="reference-query-terminal__secondary-head">
          <span>ASSOCIATION TAGS</span>
          <button
            aria-pressed="true"
            class="archive-overview__tag is-active"
            data-archive-tag="all"
            data-archive-tag-categories="[]"
            data-archive-tag-label="全部标签"
            type="button"
          >
            全部标签 <span>{items.length}</span>
          </button>
        </header>
        <div class="reference-query-terminal__tag-groups">
          {referenceTagGroups.map(({ category, tags }) => (
            <section
              class="reference-query-terminal__tag-group"
              data-reference-tag-group
              data-reference-tag-group-category={category}
            >
              <h3>{category}</h3>
              <div>
                {tags.map(([tag, { count, label }]) => (
                  <button
                    aria-pressed="false"
                    class="archive-overview__tag"
                    data-archive-tag={tag}
                    data-archive-tag-categories={JSON.stringify([...(tagCategories.get(tag) ?? [])])}
                    data-archive-tag-label={label}
                    type="button"
                  >
                    {label} <span>{count}</span>
                  </button>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
    </section>

    <header class="reference-query-terminal__results-head">
      <h2 class="reference-query-terminal__results-title">检索结果</h2>
    </header>

    <div class="reference-query-terminal__results">
      {items.map((item, index) => item.entryKind === "topic" ? (
        <a
          class="reference-query-terminal__topic"
          data-archive-card
          data-archive-card-category={item.category ?? ""}
          data-archive-covers={JSON.stringify(item.covers ?? [])}
          data-archive-search-text={[item.title, item.summary, item.eyebrow, item.meta, ...(item.tags ?? []).map(tagLabel)].filter(Boolean).join(" ")}
          data-archive-tags={JSON.stringify((item.tags ?? []).map(tagKey))}
          data-reference-entry-kind={item.entryKind ?? "default"}
          href={item.href}
        >
          <span class="reference-query-terminal__topic-code">
            <small>TOPIC GATE</small>
            <strong>{String(index + 1).padStart(2, "0")}</strong>
          </span>
          <span class="reference-query-terminal__topic-copy">
            <h3>{item.title}</h3>
            {item.summary ? <p>{item.summary}</p> : null}
          </span>
          <span class="reference-query-terminal__open-command">OPEN TOPIC</span>
        </a>
      ) : (
        <a
          class="reference-query-terminal__record"
          data-archive-card
          data-archive-card-category={item.category ?? ""}
          data-archive-covers={JSON.stringify(item.covers ?? [])}
          data-archive-search-text={[item.title, item.summary, item.eyebrow, item.meta, ...(item.tags ?? []).map(tagLabel)].filter(Boolean).join(" ")}
          data-archive-tags={JSON.stringify((item.tags ?? []).map(tagKey))}
          data-reference-entry-kind={item.entryKind ?? "default"}
          href={item.href}
        >
          <span class="reference-query-terminal__record-cover" aria-hidden="true">
            {(item.covers?.length ?? 0) > 0 ? <img alt="" data-archive-card-image loading="lazy" /> : null}
            <span>{String(index + 1).padStart(2, "0")}</span>
          </span>
          <span class="reference-query-terminal__record-copy">
            <span class="reference-query-terminal__record-meta">
              <b>{item.eyebrow}</b>
              <time>{formatDate(item.date)}</time>
            </span>
            <h3>{item.title}</h3>
            {item.summary ? <p>{item.summary}</p> : null}
            <span class="reference-query-terminal__record-foot">
              <span>{item.meta ?? "查看资料"}</span>
              <em>OPEN RECORD</em>
            </span>
          </span>
        </a>
      ))}
    </div>

    <div class="reference-query-terminal__empty" data-reference-empty hidden>
      <span>NO MATCHING RECORDS</span>
      <button data-reference-clear type="button">清除筛选</button>
    </div>
  </section>
) : (
<section class="archive-overview" data-archive-overview data-archive-style={archiveStyle} data-archive-view="timeline">
  <header class="archive-overview__hero">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="archive-overview__summary">
      <span aria-hidden="true">✧</span>
      {totalLabel} {items.length} 条
      <small>{description}</small>
    </p>

    <label class="archive-overview__search interactive-lift">
      <svg aria-hidden="true" fill="none" viewBox="0 0 24 24">
        <path d="m21 21-4.35-4.35M10.8 18.1a7.3 7.3 0 1 1 0-14.6 7.3 7.3 0 0 1 0 14.6Z" />
      </svg>
      <input data-archive-search placeholder={searchPlaceholder} type="search" />
    </label>
  </header>

  <section class="archive-overview__filters glass-card">
    <div class="archive-overview__filter-stack">
      {topCategories.length > 0 ? (
        <div class="archive-overview__category-cloud" aria-label="一级筛选">
          <button class="archive-overview__category is-active" data-archive-category="all" type="button">
            全部归档 <span>{items.length}</span>
          </button>
          {topCategories.map(([category, count]) => (
            <button class="archive-overview__category" data-archive-category={category} type="button">
              {category} <span>{count}</span>
            </button>
          ))}
        </div>
      ) : null}

      <div class="archive-overview__tag-cloud" aria-label="二级标签筛选">
        <button class="archive-overview__tag is-active" data-archive-tag="all" data-archive-tag-categories="[]" type="button">
          全部标签 <span>{items.length}</span>
        </button>
        {topTags.map(([tag, { count, label }]) => (
          <button
            class="archive-overview__tag"
            data-archive-tag={tag}
            data-archive-tag-categories={JSON.stringify([...(tagCategories.get(tag) ?? [])])}
            type="button"
          >
            {label} <span>{count}</span>
          </button>
        ))}
      </div>
    </div>

    {showViewSwitch ? (
      <div class="archive-overview__view-switch" aria-label="归档显示方式">
        <button aria-pressed="true" class="is-active" data-archive-view-button="timeline" type="button">
          <span aria-hidden="true">☰</span>
          串联链路
        </button>
        <button aria-pressed="false" data-archive-view-button="grid" type="button">
          <span aria-hidden="true">▦</span>
          矩阵网格
        </button>
      </div>
    ) : null}
  </section>

  <div class="archive-overview__timeline">
    {items.map((item, index) => (
      <a
        class="archive-overview-card glass-card interactive-lift"
        data-archive-card
        data-archive-card-category={item.category ?? ""}
        data-archive-covers={JSON.stringify(item.covers ?? [])}
        data-archive-search-text={[item.title, item.summary, item.eyebrow, item.meta, ...(item.tags ?? []).map(tagLabel)].filter(Boolean).join(" ")}
        data-archive-tags={JSON.stringify((item.tags ?? []).map(tagKey))}
        href={item.href}
        style={`--card-index: ${index}; --archive-card-row: ${index + 1}`}
      >
        <span class="archive-overview-card__rail" aria-hidden="true"></span>
        <div class="archive-overview-card__image" aria-hidden="true">
          {(item.covers?.length ?? 0) > 0 ? <img alt="" data-archive-card-image loading="lazy" /> : null}
          <span>{String(index + 1).padStart(2, "0")}</span>
        </div>
        <div class="archive-overview-card__body">
          <div class="archive-overview-card__meta">
            <span>{item.eyebrow}</span>
            <time>{formatDate(item.date)}</time>
          </div>
          <h2>{item.title}</h2>
          {(item.tags?.length ?? 0) > 0 ? (
            <div class="archive-overview-card__tags" aria-label="标签">
              {item.tags?.slice(0, 4).map((tag) => <span>#{tagLabel(tag)}</span>)}
            </div>
          ) : null}
          {item.summary ? <p>{item.summary}</p> : null}
          <div class="archive-overview-card__footer">
            <span>{item.meta ?? "进入归档"}</span>
            <em>打开</em>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
)}

<script is:inline>
  (() => {
    const normalize = (value) => (value || "").toString().trim().toLocaleLowerCase();
    const parseJsonList = (value) => {
      try {
        const parsed = JSON.parse(value || "[]");
        return Array.isArray(parsed) ? parsed : [];
      } catch {
        return [];
      }
    };
    const coverQueues = new Map();

    const shuffleArchiveCovers = (covers) => {
      const queue = [...covers];
      for (let index = queue.length - 1; index > 0; index -= 1) {
        const swapIndex = Math.floor(Math.random() * (index + 1));
        [queue[index], queue[swapIndex]] = [queue[swapIndex], queue[index]];
      }
      return queue;
    };

    const takeArchiveCover = (covers) => {
      const key = JSON.stringify(covers);
      let queue = coverQueues.get(key);
      if (!queue || queue.length === 0) {
        queue = shuffleArchiveCovers(covers);
        coverQueues.set(key, queue);
      }
      return queue.shift();
    };

    const uniqueArchiveCovers = (covers) => [...new Set(covers.filter(Boolean))];

    const syncArchiveButtonState = (root) => {
      const activeCategory = root.dataset.archiveCategory || "all";
      const activeTag = root.dataset.archiveTag || "all";
      root.querySelectorAll("[data-archive-category]").forEach((button) => {
        const isActive = button.dataset.archiveCategory === activeCategory;
        button.classList.toggle("is-active", isActive);
        button.setAttribute("aria-pressed", String(isActive));
      });
      root.querySelectorAll("[data-archive-tag]").forEach((button) => {
        const isActive = button.dataset.archiveTag === activeTag;
        button.classList.toggle("is-active", isActive);
        button.setAttribute("aria-pressed", String(isActive));
      });
    };

    const syncReferenceActiveSummary = (root) => {
      const summary = root.querySelector("[data-reference-active-filter-summary]");
      if (!summary) {
        return;
      }
      const activeCategory = root.dataset.archiveCategory || "all";
      const activeTag = root.dataset.archiveTag || "all";
      const categoryButton = [...root.querySelectorAll("[data-archive-category]")]
        .find((button) => button.dataset.archiveCategory === activeCategory);
      const tagButton = [...root.querySelectorAll("[data-archive-tag]")]
        .find((button) => button.dataset.archiveTag === activeTag);
      const primaryLabel = summary.querySelector("[data-reference-active-primary]");
      const tagLabel = summary.querySelector("[data-reference-active-tag]");
      const clearTag = summary.querySelector("[data-reference-clear-tag]");
      if (primaryLabel) {
        primaryLabel.textContent = categoryButton?.dataset.archiveCategoryLabel || "全部";
      }
      if (tagLabel) {
        tagLabel.textContent = tagButton?.dataset.archiveTagLabel || "全部标签";
      }
      if (clearTag) {
        clearTag.hidden = activeTag === "all";
      }
      const hasActiveFilter = activeCategory !== "all" || activeTag !== "all";
      summary.hidden = !hasActiveFilter || root.dataset.referenceTagPanelOpen === "true";
    };

    const syncReferenceTagDisclosure = (root, open = false) => {
      const panel = root.querySelector("[data-reference-secondary-panel]");
      const toggle = root.querySelector("[data-reference-tag-toggle]");
      const symbol = root.querySelector("[data-reference-tag-symbol]");
      root.dataset.referenceTagPanelOpen = String(open);
      if (panel) {
        panel.hidden = !open;
      }
      if (toggle) {
        toggle.setAttribute("aria-expanded", String(open));
      }
      if (symbol) {
        symbol.textContent = open ? "−" : "+";
      }
      syncReferenceActiveSummary(root);
    };

    const applyArchiveFilters = (root) => {
      const activeCategory = root.dataset.archiveCategory || "all";
      const activeTag = root.dataset.archiveTag || "all";
      const query = normalize(root.querySelector("[data-archive-search]")?.value);
      const cards = [...root.querySelectorAll("[data-archive-card]")];
      let visibleCount = 0;

      for (const card of cards) {
        const tags = parseJsonList(card.dataset.archiveTags);
        const matchesCategory = activeCategory === "all" || card.dataset.archiveCardCategory === activeCategory;
        const matchesTag = activeTag === "all" || tags.includes(activeTag);
        const matchesQuery = !query || normalize(card.dataset.archiveSearchText).includes(query);
        card.hidden = !(matchesCategory && matchesTag && matchesQuery);
        if (!card.hidden) {
          visibleCount += 1;
        }
      }

      const visibleCountNode = root.querySelector("[data-reference-visible-count]");
      if (visibleCountNode) {
        visibleCountNode.textContent = String(visibleCount).padStart(2, "0");
      }
      const emptyState = root.querySelector("[data-reference-empty]");
      if (emptyState) {
        emptyState.hidden = visibleCount > 0;
      }
      const hasActiveQuery = Boolean(query) || activeCategory !== "all" || activeTag !== "all";
      root.querySelectorAll("[data-reference-clear]").forEach((button) => {
        button.hidden = !hasActiveQuery;
      });
      const searchSlot = root.querySelector(".reference-query-terminal__search-slot");
      if (searchSlot) {
        searchSlot.dataset.hasQuery = String(Boolean(query));
      }
      syncReferenceActiveSummary(root);
    };

    const syncArchiveTagVisibility = (root) => {
      const activeCategory = root.dataset.archiveCategory || "all";
      const activeTag = root.dataset.archiveTag || "all";
      const activeTagButton = [...root.querySelectorAll("[data-archive-tag]")]
        .find((button) => button.dataset.archiveTag === activeTag);
      const activeTagCategories = parseJsonList(activeTagButton?.dataset.archiveTagCategories);
      const activeTagIsVisible = activeTag === "all" || activeCategory === "all" || activeTagCategories.includes(activeCategory);

      root.querySelectorAll("[data-reference-tag-group]").forEach((group) => {
        group.hidden = activeCategory !== "all" && group.dataset.referenceTagGroupCategory !== activeCategory;
      });

      if (!activeTagIsVisible) {
        root.dataset.archiveTag = "all";
      }
      syncArchiveButtonState(root);
      syncReferenceActiveSummary(root);
    };

    const setArchiveCategory = (root, button) => {
      root.dataset.archiveCategory = button.dataset.archiveCategory || "all";
      syncArchiveButtonState(root);
      syncArchiveTagVisibility(root);
      applyArchiveFilters(root);
    };

    const setArchiveTag = (root, button) => {
      root.dataset.archiveTag = button.dataset.archiveTag || "all";
      syncArchiveButtonState(root);
      applyArchiveFilters(root);
    };

    const resetReferenceQuery = (root) => {
      const search = root.querySelector("[data-archive-search]");
      if (search) {
        search.value = "";
      }
      root.dataset.archiveCategory = "all";
      root.dataset.archiveTag = "all";
      syncArchiveButtonState(root);
      syncArchiveTagVisibility(root);
      applyArchiveFilters(root);
    };

    const setArchiveView = (root, view) => {
      root.dataset.archiveView = view;
      root.querySelectorAll("[data-archive-view-button]").forEach((item) => {
        const isActive = item.dataset.archiveViewButton === view;
        item.classList.toggle("is-active", isActive);
        item.setAttribute("aria-pressed", String(isActive));
      });
    };

    const hydrateArchiveCardImages = (root) => {
      const cards = [...root.querySelectorAll("[data-archive-card]")];
      const rootCoverQueue = shuffleArchiveCovers(
        uniqueArchiveCovers(cards.flatMap((card) => parseJsonList(card.dataset.archiveCovers))),
      );
      const usedRootCovers = new Set();

      const takeRootUniqueCover = (covers) => {
        const uniqueCovers = uniqueArchiveCovers(covers);
        const queuedCover = rootCoverQueue.find((cover) => uniqueCovers.includes(cover) && !usedRootCovers.has(cover));
        const selectedCover =
          queuedCover ??
          uniqueCovers.find((cover) => !usedRootCovers.has(cover)) ??
          takeArchiveCover(uniqueCovers);

        if (selectedCover) {
          usedRootCovers.add(selectedCover);
        }

        return selectedCover;
      };

      cards.forEach((card) => {
        const image = card.querySelector("[data-archive-card-image]");
        const covers = parseJsonList(card.dataset.archiveCovers);
        if (!image || covers.length === 0) {
          return;
        }
        if (image.dataset.archiveAssignedCover) {
          return;
        }

        const selectedCover = takeRootUniqueCover(covers);
        if (!selectedCover) {
          return;
        }
        image.addEventListener(
          "load",
          () => {
            const isPortrait = image.naturalHeight > image.naturalWidth;
            card.classList.toggle("is-portrait", isPortrait);
            card.classList.toggle("is-landscape", !isPortrait);
          },
          { once: true },
        );
        image.src = selectedCover;
        image.dataset.archiveAssignedCover = selectedCover;
        card.classList.add("has-cover");
      });
    };

    const initArchiveOverviews = () => {
      document.querySelectorAll("[data-archive-overview]").forEach((root) => {
        root.dataset.archiveCategory ||= "all";
        root.dataset.archiveTag ||= "all";
        root.dataset.archiveView ||= "timeline";
        syncArchiveTagVisibility(root);
        setArchiveView(root, root.dataset.archiveView);
        if (root.matches("[data-reference-query-terminal]")) {
          syncReferenceTagDisclosure(root, false);
        }
        hydrateArchiveCardImages(root);
        applyArchiveFilters(root);
      });
    };

    window.applyArchiveFilters = applyArchiveFilters;
    window.initArchiveOverviews = initArchiveOverviews;

    if (!window.__archiveOverviewReady) {
      window.__archiveOverviewReady = true;

      document.addEventListener("click", (event) => {
        const target = event.target instanceof Element ? event.target : null;
        document.querySelectorAll('[data-reference-query-terminal][data-reference-tag-panel-open="true"]').forEach((root) => {
          if (!root.contains(target)) {
            syncReferenceTagDisclosure(root, false);
          }
        });

        const tagDisclosure = target?.closest("[data-reference-tag-toggle]");
        if (tagDisclosure) {
          const root = tagDisclosure.closest("[data-archive-overview]");
          if (root) {
            syncReferenceTagDisclosure(root, root.dataset.referenceTagPanelOpen !== "true");
          }
          return;
        }

        const clearTagButton = target?.closest("[data-reference-clear-tag]");
        if (clearTagButton) {
          const root = clearTagButton.closest("[data-archive-overview]");
          const allTag = root?.querySelector('[data-archive-tag="all"]');
          if (root && allTag) {
            setArchiveTag(root, allTag);
          }
          return;
        }

        const clearButton = target?.closest("[data-reference-clear]");
        if (clearButton) {
          const root = clearButton.closest("[data-archive-overview]");
          if (root) {
            resetReferenceQuery(root);
            root.querySelector("[data-archive-search]")?.focus();
          }
          return;
        }

        const viewButton = target?.closest("[data-archive-view-button]");
        if (viewButton) {
          const root = viewButton.closest("[data-archive-overview]");
          if (root) {
            setArchiveView(root, viewButton.dataset.archiveViewButton || "timeline");
          }
          return;
        }

        const categoryButton = target?.closest("button[data-archive-category]");
        if (categoryButton) {
          const root = categoryButton.closest("[data-archive-overview]");
          if (root) {
            setArchiveCategory(root, categoryButton);
          }
          return;
        }

        const tagButton = target?.closest("button[data-archive-tag]");
        if (tagButton) {
          const root = tagButton.closest("[data-archive-overview]");
          if (root) {
            setArchiveTag(root, tagButton);
          }
        }
      });

      document.addEventListener("input", (event) => {
        const target = event.target instanceof Element ? event.target : null;
        const search = target?.closest("[data-archive-search]");
        const root = search?.closest("[data-archive-overview]");
        if (root) {
          applyArchiveFilters(root);
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") {
          return;
        }
        const root = document.querySelector('[data-reference-query-terminal][data-reference-tag-panel-open="true"]');
        if (root) {
          syncReferenceTagDisclosure(root, false);
          root.querySelector("[data-reference-tag-toggle]")?.focus();
        }
      });

      document.addEventListener("astro:page-load", initArchiveOverviews);
    }

    initArchiveOverviews();
  })();
</script>
