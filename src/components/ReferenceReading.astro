---
type ReadingBlock = {
  label?: string;
  original: string;
  translation?: string;
  note?: string;
  focus?: boolean;
};

interface Props {
  blocks: ReadingBlock[];
  extract: string | null;
}

const { blocks, extract } = Astro.props;
const hasCuratedBlocks = blocks.length > 0;
const extractParagraphs = (extract ?? "")
  .split(/\r?\n\s*\r?\n/u)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
---

{
  hasCuratedBlocks ? (
    <section class="reference-reading__state" data-reference-reading-state="curated">
      <header class="reference-reading__header">
        <p>CURATED SOURCE</p>
        <h2>正文阅读</h2>
      </header>
      <div class="reference-reading__blocks">
        {blocks.map((block, index) => (
          <article class="reference-reading__block">
            <div class="reference-reading__block-head">
              <p>{block.label ?? `正文段落 ${String(index + 1).padStart(2, "0")}`}</p>
              {block.focus && <span class="reference-reading__focus">视频重点</span>}
            </div>
            <div class="reference-reading__original">
              <strong>原文</strong>
              <p>{block.original}</p>
            </div>
            {block.translation && (
              <div class="reference-reading__translation">
                <strong>对照翻译</strong>
                <p>{block.translation}</p>
              </div>
            )}
            {block.note && (
              <div class="reference-reading__note">
                <strong>编者备注</strong>
                <p>{block.note}</p>
              </div>
            )}
          </article>
        ))}
      </div>
    </section>
  ) : extractParagraphs.length > 0 ? (
    <section class="reference-reading__state" data-reference-reading-state="extract">
      <header class="reference-reading__header">
        <p>ARCHIVE EXTRACT</p>
        <h2>站内摘录</h2>
      </header>
      <div class="reference-reading__extract">
        {extractParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>
  ) : (
    <section class="reference-reading__state" data-reference-reading-state="pending">
      <p class="reference-reading__pending">
        <span aria-hidden="true">STATUS / PENDING</span>
        <strong>当前资料暂无可展示的站内正文</strong>
      </p>
    </section>
  )
}
