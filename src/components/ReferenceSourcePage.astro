---
import BaseLayout from "../layouts/BaseLayout.astro";
import ReferenceIndexDrawer from "./ReferenceIndexDrawer.astro";
import ReferenceReading from "./ReferenceReading.astro";
import ReferenceChapterRoute from "./ReferenceChapterRoute.astro";
import type { ReferenceReadingDocument } from "../lib/reference-publication";
import "../styles/reference-source-reading.css";

interface RouteLink {
  slug: string;
  title: string;
}

interface LinkItem {
  href: string;
  title: string;
}

interface Props {
  entry: {
    slug: string;
    data: {
      title: string;
      summary: string;
      date: Date;
      tags?: string[];
      attachments?: string[];
      librarySection?: string;
      sourceType?: string;
      readingMode?: "curated" | "extract";
    };
  };
  referenceIntro: string;
  readingState: { mode: "curated" | "extract"; blocks: Array<{ label?: string; original: string; translation?: string; note?: string; focus?: boolean }>; extract: string | null; document?: ReferenceReadingDocument };
  networkLinks: { relatedReferences: LinkItem[]; relatedScripts: LinkItem[] };
  backlinks: Array<{ href: string; title: string; kind: string }>;
  sourceNeighbors: { previous: RouteLink | null; next: RouteLink | null };
  sourcePosition: number;
  sourceTotal: number;
}

const {
  entry,
  referenceIntro,
  readingState,
  networkLinks,
  backlinks,
  sourceNeighbors,
  sourcePosition,
  sourceTotal
} = Astro.props;
const sourceCode = String(sourcePosition + 1).padStart(2, "0");
const sourceCount = String(sourceTotal).padStart(2, "0");
const chapterCount = readingState.document?.chapters.length ?? 0;
const chapterTotal = String(chapterCount).padStart(2, "0");
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <div class="reference-source" data-reference-source-page data-reference-source-slug={entry.slug}>
    <div class="reference-source__progress" data-reference-progress aria-hidden="true"><span data-reference-progress-bar></span></div>
    <button
      class="reference-source__index-trigger"
      data-reference-index-trigger
      aria-controls="reference-index"
      aria-expanded="false"
      type="button"
    >
      <span>INDEX</span><strong>+</strong>
    </button>

    <header class="reference-source__dossier">
      <div class="reference-source__dossier-meta">
        <p>SOURCE / {sourceCode} — {sourceCount}</p>
        <p>{entry.data.librarySection ?? "REFERENCE ARCHIVE"}</p>
      </div>
      <div class="reference-source__dossier-copy">
        <h1>{entry.data.title}</h1>
        <p>{entry.data.summary}</p>
      </div>
      <div class="reference-source__dossier-status">
        <span>{entry.data.sourceType ?? "SOURCE"}</span>
        <time datetime={entry.data.date.toISOString()}>{entry.data.date.toISOString().slice(0, 10)}</time>
      </div>
    </header>

    <div class="reference-source__progress-copy" data-reference-progress-copy>
      <span>CHAPTER / <b data-reference-progress-section>00</b> / <span data-reference-progress-total>{chapterTotal}</span></span>
      <span class="reference-source__progress-actions">
        <output data-reference-progress-value>0%</output>
        {chapterCount > 1 && <button
          class="reference-chapter-launcher"
          type="button"
          aria-controls="reference-chapter-panel"
          aria-expanded="false"
          data-reference-chapter-manual-toggle
        >
          <span>章节</span><i aria-hidden="true">+</i>
        </button>}
      </span>
    </div>

    {chapterCount > 1 && <>
      <aside class="reference-chapter-hud" data-reference-chapter-hud hidden>
        <span class="reference-chapter-hud__position"><b data-reference-current-number>00</b> / {chapterTotal}</span>
        <strong data-reference-current-title>概览</strong>
        <output data-reference-hud-progress>0%</output>
        <button
          type="button"
          aria-controls="reference-chapter-panel"
          aria-expanded="false"
          aria-label="展开本文目录"
          data-reference-chapter-hud-toggle
        ><i aria-hidden="true">+</i></button>
      </aside>
      <div class="reference-chapter-panel" id="reference-chapter-panel" data-reference-chapter-panel hidden>
        <header><strong>阅读目录</strong><span>{chapterTotal} CHAPTERS</span></header>
        <ol>
          {readingState.document?.chapters.map((chapter) => <li>
            <a href={`#${chapter.id}`} data-reference-chapter-link data-chapter-id={chapter.id}>
              <span>{String(chapter.number).padStart(2, "0")}</span>
              <span><strong>{chapter.titleZh}</strong>{chapter.summaryZh && <small>{chapter.summaryZh}</small>}</span>
            </a>
          </li>)}
        </ol>
      </div>
    </>}

    <main class="reference-source__reading-plane">
      <section class="reference-source__intro" data-reference-section>
        <p class="reference-source__section-label">EDITORIAL INTRO</p>
        <h2>这份资料在讲什么</h2>
        {readingState.document?.overviewZh.length ? readingState.document.overviewZh.map((paragraph) => <p>{paragraph}</p>) : <p>{referenceIntro}</p>}
      </section>
      <ReferenceChapterRoute chapters={readingState.document?.chapters ?? []} />
      {chapterCount > 1 && <span class="reference-chapter-hud-marker" data-reference-chapter-hud-marker aria-hidden="true"></span>}
      <section class="reference-source__reading" data-reference-section>
        <p class="reference-source__section-label">FOCUS READING</p>
        <ReferenceReading blocks={readingState.blocks} extract={readingState.extract} document={readingState.document} />
      </section>
    </main>

    <nav class="reference-source__route-strip" aria-label="资料来源连续阅读">
      {sourceNeighbors.previous ? (
        <a data-reference-route-prev href={`/references/${sourceNeighbors.previous.slug}/`}>
          <span>PREVIOUS SOURCE</span><strong>{sourceNeighbors.previous.title}</strong>
        </a>
      ) : <span class="reference-source__route-placeholder" />}
      <span class="reference-source__route-position">{sourceCode} / {sourceCount}</span>
      {sourceNeighbors.next ? (
        <a data-reference-route-next href={`/references/${sourceNeighbors.next.slug}/`}>
          <span>NEXT SOURCE</span><strong>{sourceNeighbors.next.title}</strong>
        </a>
      ) : <span class="reference-source__route-placeholder" />}
    </nav>

    <ReferenceIndexDrawer entry={entry} networkLinks={networkLinks} backlinks={backlinks} />
  </div>

  <script>
    type ReferenceSourceWindow = Window & {
      __referenceSourceReadingCleanup?: () => void;
      __referenceSourceReadingPageLoadRegistered?: boolean;
    };

    type ChapterUiState = {
      activeChapterId: string;
      hudVisible: boolean;
      panelOpen: boolean;
      returnFocusTo: HTMLElement | null;
    };

    const referenceWindow = window as ReferenceSourceWindow;
    const setupReferenceSourceReading = () => {
      referenceWindow.__referenceSourceReadingCleanup?.();

      const sourceRoot = document.querySelector<HTMLElement>("[data-reference-source-page]");
      if (!sourceRoot) return;

      const trigger = sourceRoot.querySelector<HTMLElement>("[data-reference-index-trigger]");
      const dialog = sourceRoot.querySelector<HTMLDialogElement>("dialog[data-reference-index]");
      const closeButton = sourceRoot.querySelector<HTMLElement>("[data-reference-index-close]");
      const progressBar = sourceRoot.querySelector<HTMLElement>("[data-reference-progress-bar]");
      const progressValue = sourceRoot.querySelector<HTMLOutputElement>("[data-reference-progress-value]");
      const progressSection = sourceRoot.querySelector<HTMLElement>("[data-reference-progress-section]");
      const chapters = [...sourceRoot.querySelectorAll<HTMLElement>("[data-reference-chapter]")];
      const chapterMarker = sourceRoot.querySelector<HTMLElement>("[data-reference-chapter-hud-marker]");
      const chapterManualToggle = sourceRoot.querySelector<HTMLButtonElement>("[data-reference-chapter-manual-toggle]");
      const chapterHud = sourceRoot.querySelector<HTMLElement>("[data-reference-chapter-hud]");
      const chapterHudToggle = sourceRoot.querySelector<HTMLButtonElement>("[data-reference-chapter-hud-toggle]");
      const chapterPanel = sourceRoot.querySelector<HTMLElement>("[data-reference-chapter-panel]");
      const chapterToggles = [chapterManualToggle, chapterHudToggle].filter((item): item is HTMLButtonElement => Boolean(item));
      const currentNumbers = [...sourceRoot.querySelectorAll<HTMLElement>("[data-reference-current-number]")];
      const currentTitles = [...sourceRoot.querySelectorAll<HTMLElement>("[data-reference-current-title]")];
      const chapterLinks = [...sourceRoot.querySelectorAll<HTMLAnchorElement>("[data-reference-chapter-link]")];
      const hudProgress = sourceRoot.querySelector<HTMLOutputElement>("[data-reference-hud-progress]");
      const desktopHudMedia = matchMedia("(min-width: 901px)");
      const chapterState: ChapterUiState = {
        activeChapterId: "",
        hudVisible: false,
        panelOpen: false,
        returnFocusTo: null,
      };
      let raf = 0;
      let hashRaf = 0;
      let dialogRaf = 0;
      let restoreIndexFocus = false;

      const syncChapterPanel = () => {
        if (chapterPanel) chapterPanel.hidden = !chapterState.panelOpen;
        chapterToggles.forEach((toggle) => {
          toggle.setAttribute("aria-expanded", String(chapterState.panelOpen));
          const symbol = toggle.querySelector<HTMLElement>("i");
          if (symbol) symbol.textContent = chapterState.panelOpen ? "-" : "+";
        });
      };
      const closeChapterPanel = (restoreFocus = true) => {
        if (!chapterState.panelOpen) return;
        const returnTarget = chapterState.returnFocusTo;
        chapterState.panelOpen = false;
        chapterState.returnFocusTo = null;
        syncChapterPanel();
        if (restoreFocus) returnTarget?.focus({ preventScroll: true });
      };
      const toggleChapterPanel = (toggle: HTMLButtonElement) => {
        if (chapterState.panelOpen) {
          closeChapterPanel();
          return;
        }
        chapterState.panelOpen = true;
        chapterState.returnFocusTo = toggle;
        syncChapterPanel();
      };
      const setHudVisible = (visible: boolean) => {
        chapterState.hudVisible = visible && desktopHudMedia.matches;
        if (chapterHud) chapterHud.hidden = !chapterState.hudVisible;
        if (chapterManualToggle) chapterManualToggle.hidden = chapterState.hudVisible;
        if (chapterState.panelOpen && chapterState.returnFocusTo?.hidden) {
          chapterState.returnFocusTo = chapterState.hudVisible ? chapterHudToggle : chapterManualToggle;
        }
      };
      const setActiveChapter = (id: string) => {
        const chapter = chapters.find((item) => item.id === id);
        if (!chapter) return;
        chapterState.activeChapterId = id;
        chapterLinks.forEach((link) => {
          if (link.dataset.chapterId === id) link.setAttribute("aria-current", "location");
          else link.removeAttribute("aria-current");
        });
        currentNumbers.forEach((node) => node.textContent = chapter.dataset.chapterNumber ?? "01");
        currentTitles.forEach((node) => node.textContent = chapter.querySelector("h2")?.textContent ?? "");
        if (progressSection) progressSection.textContent = chapter.dataset.chapterNumber ?? "01";
      };

      const syncClosed = () => {
        trigger?.setAttribute("aria-expanded", "false");
        if (restoreIndexFocus) trigger?.focus();
        restoreIndexFocus = false;
      };
      const closeIndex = () => {
        if (dialog?.open) dialog.close();
        else syncClosed();
      };
      const openIndex = () => {
        if (!dialog || dialog.open) return;
        const scrollPosition = { x: window.scrollX, y: window.scrollY };
        trigger?.setAttribute("aria-expanded", "true");
        restoreIndexFocus = true;
        dialog.showModal();
        closeButton?.focus({ preventScroll: true });
        dialogRaf = requestAnimationFrame(() => {
          window.scrollTo(scrollPosition.x, scrollPosition.y);
          dialogRaf = requestAnimationFrame(() => window.scrollTo(scrollPosition.x, scrollPosition.y));
        });
      };
      const updateProgress = () => {
        raf = 0;
        const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        const ratio = Math.min(1, Math.max(0, window.scrollY / max));
        progressBar?.style.setProperty("--reference-progress", `${ratio * 100}%`);
        const progressText = `${Math.round(ratio * 100)}%`;
        if (progressValue) progressValue.textContent = progressText;
        if (hudProgress) hudProgress.textContent = progressText;
        syncHudFromMarker();
      };
      const onScroll = () => {
        if (!raf) raf = requestAnimationFrame(updateProgress);
      };
      const onDialogClick = (event: MouseEvent) => {
        if (event.target === dialog) closeIndex();
      };
      const onChapterToggle = (event: Event) => toggleChapterPanel(event.currentTarget as HTMLButtonElement);
      const onDocumentClick = (event: MouseEvent) => {
        const target = event.target as Node;
        if (
          chapterState.panelOpen &&
          !chapterPanel?.contains(target) &&
          !chapterToggles.some((toggle) => toggle.contains(target))
        ) closeChapterPanel();
      };
      const onDocumentKeydown = (event: KeyboardEvent) => {
        if (event.key === "Escape" && chapterState.panelOpen) closeChapterPanel();
      };
      const fixedLayerMetrics = () => {
        const sourceStyle = getComputedStyle(sourceRoot);
        const shellHeight = Number.parseFloat(sourceStyle.getPropertyValue("--top-nav-shell-height")) || 72;
        const progressHeight = Number.parseFloat(sourceStyle.getPropertyValue("--reference-progress-height")) || 2;
        const hudHeight = desktopHudMedia.matches
          ? Number.parseFloat(sourceStyle.getPropertyValue("--reference-chapter-hud-height")) || 44
          : 0;
        return { progressHeight, hudHeight, shellHeight };
      };
      const syncHudFromMarker = () => {
        if (!chapterMarker) {
          setHudVisible(false);
          return;
        }
        const { progressHeight, shellHeight } = fixedLayerMetrics();
        setHudVisible(chapterMarker.getBoundingClientRect().top <= shellHeight + progressHeight);
      };
      const scrollToChapter = (chapter: HTMLElement, behavior: ScrollBehavior | "instant" = "instant") => {
        const { progressHeight, hudHeight, shellHeight } = fixedLayerMetrics();
        const top = window.scrollY + chapter.getBoundingClientRect().top - shellHeight - progressHeight - hudHeight - 10;
        window.scrollTo({ top, behavior: behavior as ScrollBehavior });
      };
      const onChapterLink = (event: MouseEvent) => {
        const link = event.currentTarget as HTMLAnchorElement;
        const id = link.hash.slice(1);
        const chapter = chapters.find((item) => item.id === id);
        if (!chapter) return;
        event.preventDefault();
        closeChapterPanel(false);
        if (location.hash !== `#${id}`) history.pushState(null, "", `#${id}`);
        scrollToChapter(chapter, matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth");
        chapter.querySelector<HTMLElement>("h2")?.focus({ preventScroll: true });
        setActiveChapter(id);
      };
      const chapterObserver = new IntersectionObserver((entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting).sort((left, right) => left.boundingClientRect.top - right.boundingClientRect.top);
        if (visible[0]?.target.id && visible[0].target.id !== chapterState.activeChapterId) setActiveChapter(visible[0].target.id);
      }, { rootMargin: "-25% 0px -62% 0px", threshold: 0 });
      chapters.forEach((chapter) => chapterObserver.observe(chapter));
      const markerObserver = chapterMarker ? new IntersectionObserver(
        syncHudFromMarker,
        { threshold: 0 },
      ) : null;
      markerObserver?.observe(chapterMarker!);
      const onHudMediaChange = syncHudFromMarker;
      const cleanup = () => {
        restoreIndexFocus = false;
        if (dialog?.open) dialog.close();
        closeChapterPanel(false);
        trigger?.removeEventListener("click", openIndex);
        closeButton?.removeEventListener("click", closeIndex);
        dialog?.removeEventListener("click", onDialogClick);
        dialog?.removeEventListener("close", syncClosed);
        chapterToggles.forEach((toggle) => toggle.removeEventListener("click", onChapterToggle));
        chapterLinks.forEach((link) => link.removeEventListener("click", onChapterLink));
        document.removeEventListener("click", onDocumentClick);
        document.removeEventListener("keydown", onDocumentKeydown);
        window.removeEventListener("scroll", onScroll);
        desktopHudMedia.removeEventListener("change", onHudMediaChange);
        document.removeEventListener("astro:before-swap", cleanup);
        chapterObserver.disconnect();
        markerObserver?.disconnect();
        if (raf) cancelAnimationFrame(raf);
        if (hashRaf) cancelAnimationFrame(hashRaf);
        if (dialogRaf) cancelAnimationFrame(dialogRaf);
      };

      trigger?.addEventListener("click", openIndex);
      closeButton?.addEventListener("click", closeIndex);
      dialog?.addEventListener("click", onDialogClick);
      dialog?.addEventListener("close", syncClosed);
      chapterToggles.forEach((toggle) => toggle.addEventListener("click", onChapterToggle));
      chapterLinks.forEach((link) => link.addEventListener("click", onChapterLink));
      document.addEventListener("click", onDocumentClick);
      document.addEventListener("keydown", onDocumentKeydown);
      window.addEventListener("scroll", onScroll, { passive: true });
      desktopHudMedia.addEventListener("change", onHudMediaChange);
      document.addEventListener("astro:before-swap", cleanup);
      syncChapterPanel();
      setHudVisible(false);
      updateProgress();
      if (location.hash && chapters.some((chapter) => `#${chapter.id}` === location.hash)) {
        hashRaf = requestAnimationFrame(() => {
          const chapter = chapters.find((item) => `#${item.id}` === location.hash);
          if (chapter) scrollToChapter(chapter);
        });
        setActiveChapter(location.hash.slice(1));
      }

      referenceWindow.__referenceSourceReadingCleanup = cleanup;
    };

    if (!referenceWindow.__referenceSourceReadingPageLoadRegistered) {
      document.addEventListener("astro:page-load", setupReferenceSourceReading);
      referenceWindow.__referenceSourceReadingPageLoadRegistered = true;
    }
    setupReferenceSourceReading();
  </script>
</BaseLayout>
