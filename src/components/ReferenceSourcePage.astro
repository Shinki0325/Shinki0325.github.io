---
import BaseLayout from "../layouts/BaseLayout.astro";
import ReferenceIndexDrawer from "./ReferenceIndexDrawer.astro";
import ReferenceReading from "./ReferenceReading.astro";
import ReferenceChapterRoute from "./ReferenceChapterRoute.astro";
import type { ReferenceReadingDocument } from "../lib/reference-publication";
import "../styles/reference-source-reading.css";

interface RouteLink {
  slug: string;
  title: string;
}

interface LinkItem {
  href: string;
  title: string;
}

interface Props {
  entry: {
    slug: string;
    data: {
      title: string;
      summary: string;
      date: Date;
      tags?: string[];
      attachments?: string[];
      librarySection?: string;
      sourceType?: string;
      readingMode?: "curated" | "extract";
    };
  };
  referenceIntro: string;
  readingState: { mode: "curated" | "extract"; blocks: Array<{ label?: string; original: string; translation?: string; note?: string; focus?: boolean }>; extract: string | null; document?: ReferenceReadingDocument };
  networkLinks: { relatedReferences: LinkItem[]; relatedScripts: LinkItem[] };
  backlinks: Array<{ href: string; title: string; kind: string }>;
  sourceNeighbors: { previous: RouteLink | null; next: RouteLink | null };
  sourcePosition: number;
  sourceTotal: number;
}

const {
  entry,
  referenceIntro,
  readingState,
  networkLinks,
  backlinks,
  sourceNeighbors,
  sourcePosition,
  sourceTotal
} = Astro.props;
const sourceCode = String(sourcePosition + 1).padStart(2, "0");
const sourceCount = String(sourceTotal).padStart(2, "0");
const chapterCount = readingState.document?.chapters.length ?? 0;
const chapterTotal = String(chapterCount).padStart(2, "0");
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <div class="reference-source" data-reference-source-page data-reference-source-slug={entry.slug}>
    <div class="reference-source__progress" data-reference-progress aria-hidden="true"><span data-reference-progress-bar></span></div>
    <button
      class="reference-source__index-trigger"
      data-reference-index-trigger
      aria-controls="reference-index"
      aria-expanded="false"
      type="button"
    >
      <span>INDEX</span><strong>+</strong>
    </button>

    <header class="reference-source__dossier">
      <div class="reference-source__dossier-meta">
        <p>SOURCE / {sourceCode} — {sourceCount}</p>
        <p>{entry.data.librarySection ?? "REFERENCE ARCHIVE"}</p>
      </div>
      <div class="reference-source__dossier-copy">
        <h1>{entry.data.title}</h1>
        <p>{entry.data.summary}</p>
      </div>
      <div class="reference-source__dossier-status">
        <span>{entry.data.sourceType ?? "SOURCE"}</span>
        <time datetime={entry.data.date.toISOString()}>{entry.data.date.toISOString().slice(0, 10)}</time>
      </div>
    </header>

    <div class="reference-source__progress-copy" data-reference-progress-copy>
      <span>CHAPTER / <b data-reference-progress-section>{chapterCount ? "01" : "00"}</b> / <span data-reference-progress-total>{chapterTotal}</span></span>
      <output data-reference-progress-value>0%</output>
    </div>

    <main class="reference-source__reading-plane">
      <section class="reference-source__intro" data-reference-section>
        <p class="reference-source__section-label">EDITORIAL INTRO</p>
        <h2>这份资料在讲什么</h2>
        {readingState.document?.overviewZh.length ? readingState.document.overviewZh.map((paragraph) => <p>{paragraph}</p>) : <p>{referenceIntro}</p>}
      </section>
      <ReferenceChapterRoute chapters={readingState.document?.chapters ?? []} />
      <section class="reference-source__reading" data-reference-section>
        <p class="reference-source__section-label">FOCUS READING</p>
        <ReferenceReading blocks={readingState.blocks} extract={readingState.extract} document={readingState.document} />
      </section>
    </main>

    <nav class="reference-source__route-strip" aria-label="资料来源连续阅读">
      {sourceNeighbors.previous ? (
        <a data-reference-route-prev href={`/references/${sourceNeighbors.previous.slug}/`}>
          <span>PREVIOUS SOURCE</span><strong>{sourceNeighbors.previous.title}</strong>
        </a>
      ) : <span class="reference-source__route-placeholder" />}
      <span class="reference-source__route-position">{sourceCode} / {sourceCount}</span>
      {sourceNeighbors.next ? (
        <a data-reference-route-next href={`/references/${sourceNeighbors.next.slug}/`}>
          <span>NEXT SOURCE</span><strong>{sourceNeighbors.next.title}</strong>
        </a>
      ) : <span class="reference-source__route-placeholder" />}
    </nav>

    <ReferenceIndexDrawer entry={entry} networkLinks={networkLinks} backlinks={backlinks} />
  </div>

  <script>
    type ReferenceSourceWindow = Window & {
      __referenceSourceReadingCleanup?: () => void;
      __referenceSourceReadingPageLoadRegistered?: boolean;
    };

    const referenceWindow = window as ReferenceSourceWindow;
    const setupReferenceSourceReading = () => {
      referenceWindow.__referenceSourceReadingCleanup?.();

      const sourceRoot = document.querySelector<HTMLElement>("[data-reference-source-page]");
      if (!sourceRoot) return;

      const trigger = sourceRoot.querySelector<HTMLElement>("[data-reference-index-trigger]");
      const dialog = sourceRoot.querySelector<HTMLDialogElement>("dialog[data-reference-index]");
      const closeButton = sourceRoot.querySelector<HTMLElement>("[data-reference-index-close]");
      const progressBar = sourceRoot.querySelector<HTMLElement>("[data-reference-progress-bar]");
      const progressValue = sourceRoot.querySelector<HTMLOutputElement>("[data-reference-progress-value]");
      const progressSection = sourceRoot.querySelector<HTMLElement>("[data-reference-progress-section]");
      const chapters = [...sourceRoot.querySelectorAll<HTMLElement>("[data-reference-chapter]")];
      const chapterRoute = sourceRoot.querySelector<HTMLElement>("[data-reference-chapter-route]");
      const chapterSentinel = sourceRoot.querySelector<HTMLElement>("[data-reference-chapter-sentinel]");
      const chapterToggle = sourceRoot.querySelector<HTMLButtonElement>("[data-reference-chapter-toggle]");
      const chapterList = sourceRoot.querySelector<HTMLElement>("[data-reference-chapter-list]");
      const currentNumber = sourceRoot.querySelector<HTMLElement>("[data-reference-current-number]");
      const currentTitle = sourceRoot.querySelector<HTMLElement>("[data-reference-current-title]");
      const chapterLinks = [...sourceRoot.querySelectorAll<HTMLAnchorElement>("[data-reference-chapter-link]")];
      let raf = 0;
      let restoreFocus = false;
      let activeChapter = chapters[0]?.id ?? "";

      const setChapterPanel = (open: boolean) => {
        if (!chapterToggle || !chapterList) return;
        chapterToggle.setAttribute("aria-expanded", String(open));
        chapterRoute?.classList.toggle("is-open", open);
        chapterToggle.querySelector("i")!.textContent = open ? "-" : "+";
      };
      const setActiveChapter = (id: string) => {
        const chapter = chapters.find((item) => item.id === id);
        if (!chapter) return;
        activeChapter = id;
        chapterLinks.forEach((link) => link.toggleAttribute("aria-current", link.dataset.chapterId === id));
        if (currentNumber) currentNumber.textContent = chapter.dataset.chapterNumber ?? "01";
        if (currentTitle) currentTitle.textContent = chapter.querySelector("h2")?.textContent ?? "";
        if (progressSection) progressSection.textContent = chapter.dataset.chapterNumber ?? "01";
      };

      const syncClosed = () => {
        trigger?.setAttribute("aria-expanded", "false");
        if (restoreFocus) trigger?.focus();
        restoreFocus = false;
      };
      const close = () => {
        if (dialog?.open) dialog.close();
        else syncClosed();
      };
      const open = () => {
        if (!dialog || dialog.open) return;
        trigger?.setAttribute("aria-expanded", "true");
        restoreFocus = true;
        dialog.showModal();
      };
      const updateProgress = () => {
        raf = 0;
        const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        const ratio = Math.min(1, Math.max(0, window.scrollY / max));
        progressBar?.style.setProperty("--reference-progress", `${ratio * 100}%`);
        if (progressValue) progressValue.textContent = `${Math.round(ratio * 100)}%`;
      };
      const onScroll = () => {
        if (!raf) raf = requestAnimationFrame(updateProgress);
      };
      const onDialogClick = (event: MouseEvent) => {
        if (event.target === dialog) close();
      };
      const onChapterToggle = () => setChapterPanel(chapterToggle?.getAttribute("aria-expanded") !== "true");
      const onDocumentClick = (event: MouseEvent) => {
        if (chapterRoute?.classList.contains("is-open") && !chapterRoute.contains(event.target as Node)) setChapterPanel(false);
      };
      const onDocumentKeydown = (event: KeyboardEvent) => {
        if (event.key === "Escape" && chapterRoute?.classList.contains("is-open")) {
          setChapterPanel(false);
          chapterToggle?.focus();
        }
      };
      const onChapterLink = (event: MouseEvent) => {
        const link = event.currentTarget as HTMLAnchorElement;
        const id = link.hash.slice(1);
        const chapter = chapters.find((item) => item.id === id);
        if (!chapter) return;
        event.preventDefault();
        history.pushState(null, "", `#${id}`);
        chapter.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "start" });
        chapter.focus({ preventScroll: true });
        setChapterPanel(false);
        setActiveChapter(id);
      };
      const chapterObserver = new IntersectionObserver((entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting).sort((left, right) => left.boundingClientRect.top - right.boundingClientRect.top);
        if (visible[0]?.target.id && visible[0].target.id !== activeChapter) setActiveChapter(visible[0].target.id);
      }, { rootMargin: "-25% 0px -62% 0px", threshold: 0 });
      chapters.forEach((chapter) => chapterObserver.observe(chapter));
      const sentinelObserver = new IntersectionObserver(([entry]) => chapterRoute?.classList.toggle("is-compact", !entry.isIntersecting), { rootMargin: "-60px 0px 0px 0px" });
      if (chapterSentinel) sentinelObserver.observe(chapterSentinel);
      const cleanup = () => {
        restoreFocus = false;
        if (dialog?.open) dialog.close();
        trigger?.removeEventListener("click", open);
        closeButton?.removeEventListener("click", close);
        dialog?.removeEventListener("click", onDialogClick);
        dialog?.removeEventListener("close", syncClosed);
        chapterToggle?.removeEventListener("click", onChapterToggle);
        chapterLinks.forEach((link) => link.removeEventListener("click", onChapterLink));
        document.removeEventListener("click", onDocumentClick);
        document.removeEventListener("keydown", onDocumentKeydown);
        window.removeEventListener("scroll", onScroll);
        document.removeEventListener("astro:before-swap", cleanup);
        chapterObserver.disconnect();
        sentinelObserver.disconnect();
        if (raf) cancelAnimationFrame(raf);
      };

      trigger?.addEventListener("click", open);
      closeButton?.addEventListener("click", close);
      dialog?.addEventListener("click", onDialogClick);
      dialog?.addEventListener("close", syncClosed);
      chapterToggle?.addEventListener("click", onChapterToggle);
      chapterLinks.forEach((link) => link.addEventListener("click", onChapterLink));
      document.addEventListener("click", onDocumentClick);
      document.addEventListener("keydown", onDocumentKeydown);
      window.addEventListener("scroll", onScroll, { passive: true });
      document.addEventListener("astro:before-swap", cleanup);
      updateProgress();
      if (location.hash && chapters.some((chapter) => `#${chapter.id}` === location.hash)) {
        requestAnimationFrame(() => chapters.find((chapter) => `#${chapter.id}` === location.hash)?.scrollIntoView({ block: "start" }));
        setActiveChapter(location.hash.slice(1));
      } else if (activeChapter) setActiveChapter(activeChapter);

      referenceWindow.__referenceSourceReadingCleanup = cleanup;
    };

    if (!referenceWindow.__referenceSourceReadingPageLoadRegistered) {
      document.addEventListener("astro:page-load", setupReferenceSourceReading);
      referenceWindow.__referenceSourceReadingPageLoadRegistered = true;
    }
    setupReferenceSourceReading();
  </script>
</BaseLayout>
